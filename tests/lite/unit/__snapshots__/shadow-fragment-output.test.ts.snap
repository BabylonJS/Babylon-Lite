struct shadowInfo_1Uniforms { lightMatrix: mat4x4<f32>, depthValues: vec4<f32>, shadowsInfo: vec4<f32> };",
  "_vertexSlots": {
    "VB": "out.vPosFromLight_0 = shadowInfo_0.lightMatrix * worldPos4;
