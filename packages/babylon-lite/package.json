{
    "name": "babylon-lite",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts",
            "types": "./src/index.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && pnpm build:lib && pnpm build:dist",
        "build:lib": "vite build --mode lib",
        "build:dist": "vite build --mode dist",
        "dev": "vite build --mode lib --watch"
    },
    "sideEffects": false,
    "publishConfig": {
        "types": "./build/dist/index.d.ts"
    },
    "devDependencies": {
        "@ampproject/remapping": "^2.3.0",
        "@babylonjs/havok": "^1.3.14",
        "@types/webxr": "^0.5.24",
        "@webgpu/types": "^0.1.72",
        "typescript": "^6.0.3",
        "vite": "^6.4.3",
        "vite-plugin-dts": "^4.5.4"
    },
    "dependencies": {
        "@recast-navigation/core": "0.43.1",
        "@recast-navigation/generators": "0.43.1",
        "@recast-navigation/wasm": "0.43.1",
        "manifold-3d": "3.5.1",
        "text-shaper": "^0.1.28"
    }
}
